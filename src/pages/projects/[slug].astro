---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import QueryCaseAnimation from '../../components/QueryCaseAnimation.astro';
import ServiceUserAnimation from '../../components/ServiceUserAnimation.astro';
import { getPublishedProjects, type Project } from '../../lib/projects';

interface Props {
  project: Project;
  previous: Project | null;
  next: Project | null;
}

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      previous: projects[index - 1] ?? null,
      next: projects[index + 1] ?? null,
    },
  }));
}

const { project, previous, next } = Astro.props;
const { Content, headings } = await render(project);
const isQueryCaseStudy = project.id === 'mysql-query-performance-optimization';
const isServiceUserStudy = project.id === 'service-user-query-optimization';
const isCacheCaseStudy = project.id === 'caffeine-to-redis';
const isStageStudy = isCacheCaseStudy || project.id === 'open-api-load-testing';
const tableOfContents = headings.filter(({ depth, slug }) =>
  depth === 2 ? (!isQueryCaseStudy || !slug.startsWith('case-')) : depth === 3 && !isQueryCaseStudy && !isStageStudy,
);
---

<BaseLayout title={`${project.data.title} | 손원주`} description={project.data.summary} ogType="article">
  <Header />
  <main id="main">
    <header class="project-detail-head">
      <div class="container">
        <a class="back-link" href="/projects">← Projects</a>
        <p class="page-eyebrow">{project.data.category}</p>
        <h1>{project.data.title}</h1>
        <p class="project-detail-summary">{project.data.summary}</p>
        <dl class="project-detail-meta">
          <div><dt>Company</dt><dd>{project.data.company}</dd></div>
          {project.data.period && <div><dt>Period</dt><dd>{project.data.period}</dd></div>}
          {project.data.role && <div><dt>Role</dt><dd>{project.data.role}</dd></div>}
        </dl>
        <ul class="project-skills" aria-label="사용 기술">{project.data.skills.map((skill) => <li>{skill}</li>)}</ul>
      </div>
    </header>

    <div class="container project-reading-layout">
      <article class:list={['project-prose', { 'project-prose-case-study': isQueryCaseStudy, 'project-prose-stage-study': isStageStudy, 'project-prose-cache-study': isCacheCaseStudy }]}><Content />{isServiceUserStudy && <ServiceUserAnimation />}</article>
      {isQueryCaseStudy && (
        <div class="query-animation-source" aria-hidden="true">
          <QueryCaseAnimation caseNumber={1} />
          <QueryCaseAnimation caseNumber={2} />
          <QueryCaseAnimation caseNumber={3} />
        </div>
      )}
      {tableOfContents.length > 0 && (
        <aside class="project-toc" aria-label="문서 목차">
          <p>ON THIS PAGE</p>
          <nav aria-label="프로젝트 문서 목차">
            <ol>{tableOfContents.map((heading) => <li class:list={{ 'toc-subheading': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
          </nav>
        </aside>
      )}
    </div>

    <nav class="container project-pagination" aria-label="프로젝트 이동">
      {previous ? <a href={`/projects/${previous.id}`}><small>← PREVIOUS PROJECT</small><strong>{previous.data.title}</strong></a> : <span class="project-nav-empty"><small>← PREVIOUS PROJECT</small><strong>이전 프로젝트 없음</strong></span>}
      <a class="project-pagination-all" href="/projects">All Projects</a>
      {next ? <a class="project-nav-next" href={`/projects/${next.id}`}><small>NEXT PROJECT →</small><strong>{next.data.title}</strong></a> : <span class="project-nav-empty project-nav-next"><small>NEXT PROJECT →</small><strong>다음 프로젝트 없음</strong></span>}
    </nav>
  </main>
  <Footer />

  <script>
    const setupTabs = (
      article: HTMLElement,
      headingSelector: string,
      ariaLabel: string,
      labelPattern: RegExp,
      isStage = false,
    ) => {
      const headings = Array.from(article.querySelectorAll<HTMLHeadingElement>(headingSelector));
      if (headings.length < 2) return;

      const tabList = document.createElement('div');
      tabList.className = isStage ? 'project-case-tabs project-stage-tabs' : 'project-case-tabs';
      tabList.setAttribute('role', 'tablist');
      tabList.setAttribute('aria-label', ariaLabel);
      headings[0].before(tabList);

      const tabs: HTMLButtonElement[] = [];
      const panels: HTMLElement[] = [];

      headings.forEach((heading, index) => {
        const panel = document.createElement('section');
        panel.className = isStage ? 'project-case-panel project-stage-panel' : 'project-case-panel';
        panel.id = `${heading.id}-panel`;
        panel.setAttribute('role', 'tabpanel');
        panel.tabIndex = 0;
        heading.before(panel);

        let node: Element | null = heading;
        while (node && (node === heading || node.tagName !== 'H2')) {
          const next: Element | null = node.nextElementSibling;
          panel.append(node);
          node = next;
        }

        const tab = document.createElement('button');
        tab.type = 'button';
        tab.className = isStage ? 'project-case-tab project-stage-tab' : 'project-case-tab';
        tab.id = `${heading.id}-tab`;
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', panel.id);
        panel.setAttribute('aria-labelledby', tab.id);

        const label = heading.textContent?.trim().match(labelPattern);
        const number = document.createElement('span');
        number.className = 'project-case-tab-number';
        number.textContent = label?.[1] ?? `${isStage ? 'Stage' : 'Case'} ${index + 1}`;
        const title = document.createElement('span');
        title.className = 'project-case-tab-title';
        title.textContent = label?.[2] ?? heading.textContent?.trim() ?? '';
        tab.append(number, title);
        tabList.append(tab);
        tabs.push(tab);
        panels.push(panel);
      });

      const selectTab = (index: number, focus = false) => {
        tabs.forEach((tab, tabIndex) => {
          const selected = tabIndex === index;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
          panels[tabIndex].hidden = !selected;
        });
        if (focus) tabs[index].focus();
      };

      const selectFromHash = (scrollToTarget = false) => {
        if (!window.location.hash) return false;
        const target = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
        const panel = target?.closest<HTMLElement>('.project-case-panel');
        if (!panel || !panels.includes(panel)) return false;
        selectTab(panels.indexOf(panel));
        if (scrollToTarget) requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
        return true;
      };

      tabs.forEach((tab, index) => {
        const activate = (focus = false) => {
          selectTab(index, focus);
          window.history.replaceState(null, '', `#${headings[index].id}`);
          if (isStage) tabList.scrollIntoView({ block: 'start' });
        };
        tab.addEventListener('click', () => activate());
        tab.addEventListener('keydown', (event) => {
          let nextIndex: number;
          switch (event.key) {
            case 'ArrowRight': nextIndex = (index + 1) % tabs.length; break;
            case 'ArrowLeft': nextIndex = (index - 1 + tabs.length) % tabs.length; break;
            case 'Home': nextIndex = 0; break;
            case 'End': nextIndex = tabs.length - 1; break;
            default: return;
          }
          event.preventDefault();
          tabs[nextIndex].click();
          tabs[nextIndex].focus();
        });
      });

      document.querySelector('.project-toc')?.addEventListener('click', (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
        if (!link) return;
        const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        const panel = target?.closest<HTMLElement>('.project-case-panel');
        if (panel && panels.includes(panel)) selectTab(panels.indexOf(panel));
      });

      if (!selectFromHash(true)) selectTab(0);
      window.addEventListener('hashchange', () => selectFromHash(true));
    };

    const caseArticle = document.querySelector<HTMLElement>('.project-prose-case-study');
    if (caseArticle) {
      const wrapSection = (id: string, className = '') => {
        const heading = document.getElementById(id);
        if (!heading || heading.parentElement !== caseArticle) return;
        const section = document.createElement('section');
        section.className = `project-document-section ${className}`.trim();
        section.setAttribute('aria-labelledby', id);
        heading.before(section);

        let node: Element | null = heading;
        while (node && (node === heading || node.tagName !== 'H2')) {
          const next: Element | null = node.nextElementSibling;
          section.append(node);
          node = next;
        }
      };

      wrapSection('performance-summary', 'project-summary-section');
      wrapSection('overview');
      wrapSection('tuning-cases', 'project-case-section');
      wrapSection('technical-decisions');
      wrapSection('lessons-learned');
      setupTabs(caseArticle, ':scope > h2[id^="case-"]', '쿼리 튜닝 사례', /^(Case\s+\d+)\.\s*(.*)$/);

      document.querySelectorAll<HTMLElement>('[data-query-animation]').forEach((animation) => {
        const caseId = animation.dataset.caseId;
        const heading = caseArticle.querySelector<HTMLHeadingElement>(`.project-case-panel > h2[id^="${caseId}-"]`);
        if (!heading) return;
        heading.after(animation);
        animation.removeAttribute('aria-hidden');

        type Frame = {
          side: 'before' | 'after';
          explanation: string;
          checking?: string[];
          matched?: string[];
          skipped?: string[];
        };
        const frames = JSON.parse(animation.dataset.frames ?? '[]') as Frame[];
        if (!frames.length) return;
        const narration = animation.querySelector<HTMLElement>('[data-narration]');
        const counter = animation.querySelector<HTMLElement>('[data-frame-counter]');
        const progress = animation.querySelector<HTMLElement>('[data-progress]');
        const playButton = animation.querySelector<HTMLButtonElement>('[data-action="play"]');
        let current = 0;
        let timer: number | undefined;

        const renderFrame = () => {
          const frame = frames[current];
          const visited = new Set(frames.slice(0, current).flatMap((item) => item.checking ?? []));
          const matched = new Set(frames.slice(0, current + 1).flatMap((item) => item.matched ?? []));
          const skipped = new Set(frames.slice(0, current + 1).flatMap((item) => item.skipped ?? []));
          const checking = new Set(frame.checking ?? []);
          animation.querySelectorAll<HTMLElement>('[data-side]').forEach((lane) => {
            lane.classList.toggle('is-current', lane.dataset.side === frame.side);
          });
          animation.querySelectorAll<HTMLElement>('[data-node]').forEach((node) => {
            const id = node.dataset.node ?? '';
            node.classList.toggle('is-checking', checking.has(id));
            node.classList.toggle('is-visited', visited.has(id));
            node.classList.toggle('is-matched', matched.has(id));
            node.classList.toggle('is-skipped', skipped.has(id));
          });
          if (narration) narration.textContent = frame.explanation;
          if (counter) counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(frames.length).padStart(2, '0')}`;
          if (progress) progress.style.width = `${((current + 1) / frames.length) * 100}%`;
        };

        const pause = () => {
          window.clearInterval(timer);
          timer = undefined;
          if (playButton) {
            playButton.textContent = current === frames.length - 1 ? '다시 보기 ↺' : '재생 ▶';
            playButton.setAttribute('aria-label', current === frames.length - 1 ? '애니메이션 다시 보기' : '애니메이션 재생');
          }
        };

        const play = () => {
          if (timer) return;
          if (current === frames.length - 1) current = 0;
          renderFrame();
          if (playButton) {
            playButton.textContent = '일시정지 Ⅱ';
            playButton.setAttribute('aria-label', '애니메이션 일시정지');
          }
          timer = window.setInterval(() => {
            if (current === frames.length - 1) {
              pause();
              return;
            }
            current += 1;
            renderFrame();
          }, 1700);
        };

        animation.querySelector<HTMLButtonElement>('[data-action="previous"]')?.addEventListener('click', () => {
          pause();
          current = Math.max(0, current - 1);
          renderFrame();
          pause();
        });
        animation.querySelector<HTMLButtonElement>('[data-action="next"]')?.addEventListener('click', () => {
          pause();
          current = Math.min(frames.length - 1, current + 1);
          renderFrame();
          pause();
        });
        playButton?.addEventListener('click', () => timer ? pause() : play());
        renderFrame();

        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const observer = new IntersectionObserver((entries) => {
            const visible = entries[0].isIntersecting && !animation.closest<HTMLElement>('.project-case-panel')?.hidden;
            if (visible && current === 0) play();
            if (!visible && timer) pause();
          }, { threshold: 0.35 });
          observer.observe(animation);
        }
      });
    }

    const stageArticle = document.querySelector<HTMLElement>('.project-prose-stage-study');
    if (stageArticle) {
      const stageLabel = stageArticle.classList.contains('project-prose-cache-study') ? '캐시 개선 단계' : '부하 테스트 개선 단계';
      setupTabs(stageArticle, ':scope > h2[id^="stage-"]', stageLabel, /^(Stage\s+\d+)\.\s*(.*)$/, true);
    }

    document.querySelectorAll<HTMLPreElement>('.project-prose pre.astro-code').forEach((pre) => {
      const frame = document.createElement('div');
      frame.className = 'code-frame';

      const toolbar = document.createElement('div');
      toolbar.className = 'code-toolbar';
      const language = document.createElement('span');
      language.textContent = pre.dataset.language || 'Code';

      const copy = document.createElement('button');
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', '코드 복사');
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? '');
          copy.textContent = 'Copied';
          copy.setAttribute('aria-label', '코드가 복사되었습니다');
          window.setTimeout(() => {
            copy.textContent = 'Copy';
            copy.setAttribute('aria-label', '코드 복사');
          }, 1800);
        } catch {
          copy.textContent = 'Unavailable';
          copy.setAttribute('aria-label', '코드를 복사할 수 없습니다');
        }
      });
      toolbar.append(language, copy);
      pre.before(frame);
      frame.append(toolbar, pre);
    });

    const handlerFrame = document.querySelector<HTMLElement>('.project-prose-cache-study [role="tabpanel"][id^="stage-3-"] .code-frame');
    if (handlerFrame) {
      const details = document.createElement('details');
      details.className = 'project-code-details';
      const summary = document.createElement('summary');
      summary.textContent = 'CacheErrorHandler 전체 코드 보기';
      handlerFrame.before(details);
      details.append(summary, handlerFrame);
    }
  </script>
</BaseLayout>
