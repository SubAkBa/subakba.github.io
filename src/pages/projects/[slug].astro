---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPublishedProjects, type Project } from '../../lib/projects';

interface Props {
  project: Project;
  previous: Project | null;
  next: Project | null;
}

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      previous: projects[index - 1] ?? null,
      next: projects[index + 1] ?? null,
    },
  }));
}

const { project, previous, next } = Astro.props;
const { Content, headings } = await render(project);
const isQueryCaseStudy = project.id === 'mysql-query-performance-optimization';
const tableOfContents = headings.filter(({ depth, slug }) =>
  (depth === 2 && (!isQueryCaseStudy || !slug.startsWith('case-'))) ||
  (depth === 3 && !isQueryCaseStudy),
);
---

<BaseLayout title={`${project.data.title} | 손원주`} description={project.data.summary} ogType="article">
  <Header />
  <main id="main">
    <header class="project-detail-head">
      <div class="container">
        <a class="back-link" href="/projects">← Projects</a>
        <p class="page-eyebrow">{project.data.category}</p>
        <h1>{project.data.title}</h1>
        <p class="project-detail-summary">{project.data.summary}</p>
        <dl class="project-detail-meta">
          <div><dt>Company</dt><dd>{project.data.company}</dd></div>
          {project.data.period && <div><dt>Period</dt><dd>{project.data.period}</dd></div>}
          {project.data.role && <div><dt>Role</dt><dd>{project.data.role}</dd></div>}
        </dl>
        <ul class="project-skills" aria-label="사용 기술">{project.data.skills.map((skill) => <li>{skill}</li>)}</ul>
      </div>
    </header>

    <div class="container project-reading-layout">
      <article class:list={['project-prose', { 'project-prose-case-study': isQueryCaseStudy }]}><Content /></article>
      {tableOfContents.length > 0 && (
        <aside class="project-toc" aria-label="문서 목차">
          <p>ON THIS PAGE</p>
          <nav aria-label="프로젝트 문서 목차">
            <ol>{tableOfContents.map((heading) => <li class:list={{ 'toc-subheading': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
          </nav>
        </aside>
      )}
    </div>

    <nav class="container project-pagination" aria-label="프로젝트 이동">
      {previous ? <a href={`/projects/${previous.id}`}><small>← PREVIOUS PROJECT</small><strong>{previous.data.title}</strong></a> : <span class="project-nav-empty"><small>← PREVIOUS PROJECT</small><strong>이전 프로젝트 없음</strong></span>}
      <a class="project-pagination-all" href="/projects">All Projects</a>
      {next ? <a class="project-nav-next" href={`/projects/${next.id}`}><small>NEXT PROJECT →</small><strong>{next.data.title}</strong></a> : <span class="project-nav-empty project-nav-next"><small>NEXT PROJECT →</small><strong>다음 프로젝트 없음</strong></span>}
    </nav>
  </main>
  <Footer />

  <script>
    const caseArticle = document.querySelector<HTMLElement>('.project-prose-case-study');
    if (caseArticle) {
      const headings = Array.from(caseArticle.querySelectorAll<HTMLHeadingElement>(':scope > h2[id^="case-"]'));
      if (headings.length > 1) {
        const tabList = document.createElement('div');
        tabList.className = 'project-case-tabs';
        tabList.setAttribute('role', 'tablist');
        tabList.setAttribute('aria-label', '쿼리 튜닝 사례');
        headings[0].before(tabList);

        const tabs: HTMLButtonElement[] = [];
        const panels: HTMLElement[] = [];

        headings.forEach((heading, index) => {
          const panel = document.createElement('section');
          panel.className = 'project-case-panel';
          panel.id = `${heading.id}-panel`;
          panel.setAttribute('role', 'tabpanel');
          panel.tabIndex = 0;
          heading.before(panel);

          let node: Element | null = heading;
          while (node && (node === heading || node.tagName !== 'H2')) {
            const next: Element | null = node.nextElementSibling;
            panel.append(node);
            node = next;
          }

          const tab = document.createElement('button');
          tab.type = 'button';
          tab.className = 'project-case-tab';
          tab.id = `${heading.id}-tab`;
          tab.setAttribute('role', 'tab');
          tab.setAttribute('aria-controls', panel.id);
          panel.setAttribute('aria-labelledby', tab.id);

          const label = heading.textContent?.trim().match(/^(Case\s+\d+)\.\s*(.*)$/);
          const number = document.createElement('span');
          number.className = 'project-case-tab-number';
          number.textContent = label?.[1] ?? `Case ${index + 1}`;
          const title = document.createElement('span');
          title.className = 'project-case-tab-title';
          title.textContent = label?.[2] ?? heading.textContent?.trim() ?? '';
          tab.append(number, title);
          tabList.append(tab);
          tabs.push(tab);
          panels.push(panel);
        });

        const wrapSection = (id: string, className = '') => {
          const heading = document.getElementById(id);
          if (!heading || heading.parentElement !== caseArticle) return;
          const section = document.createElement('section');
          section.className = `project-document-section ${className}`.trim();
          section.setAttribute('aria-labelledby', id);
          heading.before(section);

          let node: Element | null = heading;
          while (node && (node === heading || node.tagName !== 'H2')) {
            const next: Element | null = node.nextElementSibling;
            section.append(node);
            node = next;
          }
        };

        wrapSection('performance-summary', 'project-summary-section');
        wrapSection('overview');
        wrapSection('tuning-cases', 'project-case-section');
        wrapSection('technical-decisions');
        wrapSection('lessons-learned');

        const selectCase = (index: number, focus = false) => {
          tabs.forEach((tab, tabIndex) => {
            const selected = tabIndex === index;
            tab.setAttribute('aria-selected', String(selected));
            tab.tabIndex = selected ? 0 : -1;
            panels[tabIndex].hidden = !selected;
          });
          if (focus) tabs[index].focus();
        };

        const selectCaseFromHash = (scrollToTarget = false) => {
          if (!window.location.hash) return false;
          const target = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
          const panel = target?.closest<HTMLElement>('.project-case-panel');
          if (!panel) return false;
          selectCase(panels.indexOf(panel));
          if (scrollToTarget) requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
          return true;
        };

        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => {
            selectCase(index);
            window.history.replaceState(null, '', `#${headings[index].id}`);
          });
          tab.addEventListener('keydown', (event) => {
            let nextIndex: number;
            switch (event.key) {
              case 'ArrowRight': nextIndex = (index + 1) % tabs.length; break;
              case 'ArrowLeft': nextIndex = (index - 1 + tabs.length) % tabs.length; break;
              case 'Home': nextIndex = 0; break;
              case 'End': nextIndex = tabs.length - 1; break;
              default: return;
            }
            event.preventDefault();
            selectCase(nextIndex, true);
            window.history.replaceState(null, '', `#${headings[nextIndex].id}`);
          });
        });

        document.querySelector('.project-toc')?.addEventListener('click', (event) => {
          const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
          if (!link) return;
          const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
          const panel = target?.closest<HTMLElement>('.project-case-panel');
          if (panel) selectCase(panels.indexOf(panel));
        });

        if (!selectCaseFromHash(true)) selectCase(0);
        window.addEventListener('hashchange', () => selectCaseFromHash(true));
      }
    }

    document.querySelectorAll<HTMLPreElement>('.project-prose pre.astro-code').forEach((pre) => {
      const frame = document.createElement('div');
      frame.className = 'code-frame';

      const toolbar = document.createElement('div');
      toolbar.className = 'code-toolbar';
      const language = document.createElement('span');
      language.textContent = pre.dataset.language || 'Code';

      const copy = document.createElement('button');
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', '코드 복사');
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? '');
          copy.textContent = 'Copied';
          copy.setAttribute('aria-label', '코드가 복사되었습니다');
          window.setTimeout(() => {
            copy.textContent = 'Copy';
            copy.setAttribute('aria-label', '코드 복사');
          }, 1800);
        } catch {
          copy.textContent = 'Unavailable';
          copy.setAttribute('aria-label', '코드를 복사할 수 없습니다');
        }
      });
      toolbar.append(language, copy);
      pre.before(frame);
      frame.append(toolbar, pre);
    });
  </script>
</BaseLayout>
