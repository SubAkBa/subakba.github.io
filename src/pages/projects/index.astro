---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getPublishedProjects } from '../../lib/projects';

const projects = await getPublishedProjects();
---

<BaseLayout title="Engineering Projects | 손원주" description="손원주가 수행한 백엔드 엔지니어링 프로젝트의 문제 분석, 기술적 의사결정과 개선 과정을 살펴보세요.">
  <Header />
  <main id="main">
    <section class="page-intro">
      <div class="container">
        <a class="back-link" href="/">← Portfolio</a>
        <p class="page-eyebrow">ENGINEERING WORK / {String(projects.length).padStart(2, '0')}</p>
        <h1>Engineering<br /><span>Projects.</span></h1>
        <p>문제 상황과 분석 과정, 기술적 의사결정을 중심으로 정리한 프로젝트 기록입니다.</p>
      </div>
    </section>
    <section class="section project-index-section" aria-labelledby="project-list-title">
      <div class="container">
        <div class="listing-heading"><h2 id="project-list-title">All Projects</h2><span>{String(projects.length).padStart(2, '0')} PROJECTS</span></div>
        {projects.length > 0 ? (
          <div class="project-list-grid">
            {projects.map((project, index) => <ProjectCard project={project} number={String(index + 1).padStart(2, '0')} showMeta />)}
          </div>
        ) : <p class="empty-projects">공개된 프로젝트를 준비 중입니다.</p>}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
