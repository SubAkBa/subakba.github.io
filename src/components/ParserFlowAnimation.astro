---
const scenarios = [
  {
    id: 'create',
    label: 'CREATE TABLE',
    query: 'CREATE TABLE example_table (id INT NOT NULL);',
    request: 'CREATE TABLE 문장 1개',
    tokens: 'CREATE | TABLE | example_table | ( | id | INT | NOT | NULL | ) | ;',
    structure: '테이블 생성 → example_table → 컬럼 id (INT, NOT NULL)',
    split: '1번 문장: CREATE TABLE ... / 시작: 1행 1열',
    entities: '1번: 테이블 example_table · 컬럼 id',
    result: '문장 1개 · 테이블 example_table · 컬럼 id · 문법 오류 없음',
  },
  {
    id: 'alter',
    label: 'ALTER TABLE',
    query: 'ALTER TABLE example_table ADD COLUMN status VARCHAR(20);',
    request: 'ALTER TABLE 문장 1개',
    tokens: 'ALTER | TABLE | example_table | ADD | COLUMN | status | VARCHAR | ( | 20 | ) | ;',
    structure: '테이블 변경 → example_table → 컬럼 status 추가 (VARCHAR(20))',
    split: '1번 문장: ALTER TABLE ... / 시작: 1행 1열',
    entities: '1번: 테이블 example_table · 추가할 컬럼 status',
    result: '문장 1개 · 테이블 example_table · 추가할 컬럼 status · 문법 오류 없음',
  },
  {
    id: 'multi',
    label: '멀티 SQL',
    query: 'CREATE TABLE example_table (id INT NOT NULL);\nALTER TABLE example_table ADD COLUMN status VARCHAR(20);',
    request: 'CREATE TABLE + ALTER TABLE 문장 2개',
    tokens: 'CREATE | TABLE | … | ;\nALTER | TABLE | … | ;',
    structure: '1번: 테이블 생성 → example_table(id)\n2번: 테이블 변경 → example_table(status 추가)',
    split: '1번 CREATE TABLE: 1행 1열\n2번 ALTER TABLE: 2행 1열',
    entities: '1번: 테이블 example_table · 컬럼 id\n2번: 테이블 example_table · 추가할 컬럼 status',
    result: '문장 2개 · CREATE: example_table(id) · ALTER: status 추가 · 문법 오류 없음',
  },
];

const makeSteps = (scenario: (typeof scenarios)[number]) => [
  {
    title: 'MySQL용 분석기를 고른다',
    className: 'Backend API · MySqlDbmsParser',
    inputLabel: '들어온 요청',
    input: `DBMS: MySQL + ${scenario.request}`,
    action: '요청에 적힌 DBMS를 보고 MySQL 문법을 아는 분석기를 선택한다.',
    outputLabel: '다음으로 전달',
    output: 'MySQL 분석기 + 원본 쿼리',
    takeaway: '같은 SQL이라도 DBMS에 맞는 문법으로 읽기 시작한다.',
  },
  {
    title: '쿼리를 단어와 기호로 나눈다',
    className: 'AbstractDbmsParser · MySqlLexer',
    inputLabel: '받은 데이터',
    input: scenario.query,
    action: '공통 처리 흐름에서 MySQL 문법에 따라 키워드, 이름, 기호를 구분한다.',
    outputLabel: '구분한 조각',
    output: scenario.tokens,
    takeaway: '긴 문자열이 문법 분석에 쓸 수 있는 조각으로 바뀐다.',
  },
  {
    title: '조각을 SQL 구조로 읽는다',
    className: 'MySqlParser',
    inputLabel: '받은 데이터',
    input: scenario.tokens,
    action: '조각의 순서가 MySQL 문법에 맞는지 확인하고, 문장마다 어떤 테이블과 컬럼을 다루는지 파악한다.',
    outputLabel: '파악한 구조',
    output: scenario.structure,
    takeaway: '문법이 맞지 않으면 이 단계에서 오류를 기록한다. 이 예시는 오류가 없다.',
  },
  {
    title: '문장과 시작 위치를 기록한다',
    className: 'SplitListener',
    inputLabel: '받은 데이터',
    input: '원본 쿼리 + 파악한 SQL 구조',
    action: '구조에서 각 SQL 문장의 범위를 찾아 원본 쿼리와 시작 위치를 기록한다.',
    outputLabel: '문장 정보',
    output: scenario.split,
    takeaway: '문장이 여러 개여도 각각의 SQL과 위치를 구분한다.',
  },
  {
    title: '테이블과 컬럼 정보를 뽑는다',
    className: 'EntityCollector',
    inputLabel: '받은 데이터',
    input: '3단계에서 파악한 SQL 구조',
    action: '같은 구조에서 문장별 테이블과 컬럼의 이름을 찾아낸다.',
    outputLabel: '추출한 정보',
    output: scenario.entities,
    takeaway: '4단계와 5단계는 같은 SQL 구조를 각각 읽어 결과를 만든다.',
  },
];
---

<section class="parser-animation" data-parser-animation aria-label="예시 SQL이 Parser 결과로 바뀌는 과정">
  <div class="parser-animation-head">
    <div>
      <p class="parser-visual-label">CREATE · ALTER · 멀티 SQL</p>
      <h3>쿼리에서 테이블·컬럼 정보까지</h3>
    </div>
    <span class="parser-animation-counter" data-counter>01 / 05</span>
  </div>
  <div class="parser-animation-tabs" role="tablist" aria-label="SQL 예시 선택">
    {scenarios.map((scenario, index) => (
      <button
        type="button"
        role="tab"
        id={`parser-tab-${scenario.id}`}
        aria-controls={`parser-panel-${scenario.id}`}
        aria-selected={index === 0 ? 'true' : 'false'}
        tabindex={index === 0 ? 0 : -1}
        data-scenario-tab={index}
      >{scenario.label}</button>
    ))}
  </div>
  {scenarios.map((scenario, scenarioIndex) => {
    const steps = makeSteps(scenario);
    return (
      <div
        class="parser-animation-panel"
        role="tabpanel"
        id={`parser-panel-${scenario.id}`}
        aria-labelledby={`parser-tab-${scenario.id}`}
        data-scenario-panel={scenarioIndex}
        hidden={scenarioIndex !== 0}
      >
        <div class="parser-animation-query">
          <span>입력한 쿼리 · 설명용 예시</span>
          <code>{scenario.query}</code>
        </div>
        <ol class="parser-animation-track" aria-label="SQL 변환 단계">
          {steps.map((step, index) => (
            <li>
              <button
                type="button"
                class:list={['parser-animation-step', { 'is-current': index === 0 }]}
                data-step={index}
                aria-current={index === 0 ? 'step' : undefined}
                aria-label={`${index + 1}단계: ${step.title}`}
              >
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{step.title}</strong>
              </button>
            </li>
          ))}
        </ol>
        <div class="parser-animation-frames">
          {steps.map((step, index) => (
            <section class="parser-animation-frame" data-frame={index} hidden={index !== 0} aria-label={`${index + 1}단계: ${step.title}`}>
              <div class="parser-animation-frame-title">
                <span>STEP {String(index + 1).padStart(2, '0')}</span>
                <strong>{step.title}</strong>
                <small>담당: {step.className}</small>
              </div>
              <div class="parser-animation-transformation">
                <div class="parser-animation-data">
                  <span>{step.inputLabel}</span>
                  <code>{step.input}</code>
                </div>
                <div class="parser-animation-action">
                  <span>하는 일</span>
                  <p>{step.action}</p>
                </div>
                <div class="parser-animation-data is-output">
                  <span>{step.outputLabel}</span>
                  <code>{step.output}</code>
                </div>
              </div>
              <p class="parser-animation-handoff"><span aria-hidden="true">↳</span> {step.takeaway}</p>
            </section>
          ))}
        </div>
        <div class="parser-animation-result">
          <strong>최종적으로 얻는 정보</strong>
          <p>{scenario.result}</p>
        </div>
      </div>
    );
  })}
  <div class="parser-animation-controls">
    <button type="button" data-previous aria-label="이전 단계" disabled>← 이전</button>
    <button type="button" data-play aria-label="애니메이션 재생">재생 ▶</button>
    <button type="button" data-next aria-label="다음 단계">다음 →</button>
  </div>
  <div class="parser-animation-progress" aria-hidden="true"><span data-progress style="width: 20%"></span></div>
  <p class="parser-animation-caption">표시된 데이터는 이해를 돕기 위한 예시이며 실제 반환 형식을 그대로 표현한 것은 아니다.</p>
</section>

<script>
  const animation = document.querySelector<HTMLElement>('[data-parser-animation]');
  const slot = document.getElementById('parser-flow-animation-slot');
  if (animation && slot) {
    slot.replaceWith(animation);
    const tabs = Array.from(animation.querySelectorAll<HTMLButtonElement>('[data-scenario-tab]'));
    const panels = Array.from(animation.querySelectorAll<HTMLElement>('[data-scenario-panel]'));
    const counter = animation.querySelector<HTMLElement>('[data-counter]');
    const progress = animation.querySelector<HTMLElement>('[data-progress]');
    const previous = animation.querySelector<HTMLButtonElement>('[data-previous]');
    const next = animation.querySelector<HTMLButtonElement>('[data-next]');
    const playButton = animation.querySelector<HTMLButtonElement>('[data-play]');
    let activeScenario = 0;
    let current = 0;
    let timer: number | undefined;
    let userControlled = false;
    const activeSteps = () => Array.from(panels[activeScenario].querySelectorAll<HTMLButtonElement>('[data-step]'));

    const render = () => {
      tabs.forEach((tab, index) => {
        tab.setAttribute('aria-selected', String(index === activeScenario));
        tab.tabIndex = index === activeScenario ? 0 : -1;
      });
      panels.forEach((panel, index) => { panel.hidden = index !== activeScenario; });
      const steps = activeSteps();
      const frames = Array.from(panels[activeScenario].querySelectorAll<HTMLElement>('[data-frame]'));
      steps.forEach((step, index) => {
        const selected = index === current;
        step.classList.toggle('is-current', selected);
        if (selected) step.setAttribute('aria-current', 'step');
        else step.removeAttribute('aria-current');
        step.classList.toggle('is-complete', index < current);
      });
      frames.forEach((frame, index) => {
        frame.hidden = index !== current;
        if (index === current) {
          frame.classList.remove('is-entering');
          void frame.offsetWidth;
          frame.classList.add('is-entering');
        }
      });
      if (counter) counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(steps.length).padStart(2, '0')}`;
      if (progress) progress.style.width = `${((current + 1) / steps.length) * 100}%`;
      if (previous) previous.disabled = current === 0;
      if (next) next.disabled = current === steps.length - 1;
      if (!timer && playButton) {
        playButton.textContent = current === steps.length - 1 ? '처음부터 ↺' : '재생 ▶';
        playButton.setAttribute('aria-label', current === steps.length - 1 ? '처음부터 재생' : '애니메이션 재생');
      }
    };

    const pause = () => {
      window.clearInterval(timer);
      timer = undefined;
      if (playButton) {
        playButton.textContent = current === activeSteps().length - 1 ? '처음부터 ↺' : '재생 ▶';
        playButton.setAttribute('aria-label', current === activeSteps().length - 1 ? '처음부터 재생' : '애니메이션 재생');
      }
    };

    const play = () => {
      if (timer) return;
      if (current === activeSteps().length - 1) current = 0;
      render();
      if (playButton) {
        playButton.textContent = '일시정지 Ⅱ';
        playButton.setAttribute('aria-label', '애니메이션 일시정지');
      }
      timer = window.setInterval(() => {
        if (current === activeSteps().length - 1) {
          pause();
          return;
        }
        current += 1;
        render();
      }, 6000);
    };

    const selectScenario = (index: number) => {
      pause();
      userControlled = true;
      activeScenario = index;
      current = 0;
      render();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectScenario(index));
      tab.addEventListener('keydown', (event) => {
        let target = index;
        if (event.key === 'ArrowRight') target = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') target = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') target = 0;
        else if (event.key === 'End') target = tabs.length - 1;
        else return;
        event.preventDefault();
        selectScenario(target);
        tabs[target].focus();
      });
    });
    panels.forEach((panel) => panel.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((step, index) => step.addEventListener('click', () => {
      userControlled = true;
      pause();
      current = index;
      render();
    })));
    previous?.addEventListener('click', () => {
      userControlled = true;
      pause();
      current = Math.max(0, current - 1);
      render();
    });
    next?.addEventListener('click', () => {
      userControlled = true;
      pause();
      current = Math.min(activeSteps().length - 1, current + 1);
      render();
    });
    playButton?.addEventListener('click', () => {
      userControlled = true;
      timer ? pause() : play();
    });

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting && current === 0 && !timer && !userControlled) play();
        if (!entries[0].isIntersecting && timer) pause();
      }, { threshold: 0.35 });
      observer.observe(animation);
    }
  }
</script>
