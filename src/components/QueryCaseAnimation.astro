---
interface Frame {
  side: 'before' | 'after';
  explanation: string;
  checking?: string[];
  matched?: string[];
  skipped?: string[];
}
interface Animation {
  id: string;
  title: string;
  beforeTime: string;
  afterTime: string;
  frames: Frame[];
  note: string;
}
interface Props { caseNumber: 1 | 2 | 3 }

const animations: Record<1 | 2 | 3, Animation> = {
  1: {
    id: 'case-1', title: '인덱스 블록 탐색', beforeTime: '최대 약 50초', afterTime: '약 2초',
    frames: [
      { side: 'before', explanation: 'a=A, c=4 · b 조건 없음. a=B 블록은 탐색 대상 밖', checking: ['before-qa', 'before-qc'], skipped: ['before-B01', 'before-B02', 'before-B04', 'before-B14'] },
      { side: 'before', explanation: 'Skip Scan · (A,0,1)에서 첫 b=0 구간을 찾음', checking: ['before-b0', 'before-A01'] },
      { side: 'before', explanation: 'c=1은 불일치 · c=2 키도 건너뛰고 c=4 위치로 이동', skipped: ['before-A01', 'before-A02'] },
      { side: 'before', explanation: 'b=0 구간에서 (A,0,4) 범위를 확인', checking: ['before-A04'], matched: ['before-A04'] },
      { side: 'before', explanation: 'Skip Scan · (A,1,1)에서 다음 b=1 구간을 다시 찾음', checking: ['before-b1', 'before-A11'] },
      { side: 'before', explanation: 'c=1은 불일치 · c=2 키도 건너뛰고 c=4 위치로 이동', skipped: ['before-A11', 'before-A12'] },
      { side: 'before', explanation: 'b=1 구간에서 (A,1,4) 범위를 확인', checking: ['before-A14'], matched: ['before-A14'] },
      { side: 'after', explanation: 'a=A, b IN (0,1), c=4 · 찾을 두 범위가 명시됨', checking: ['after-qa', 'after-qb', 'after-qc'], skipped: ['after-B01', 'after-B02', 'after-B04', 'after-B14'] },
      { side: 'after', explanation: 'Range Scan · (A,0,4) 범위로 직접 이동', checking: ['after-A04'], matched: ['after-A04'], skipped: ['after-A01', 'after-A02'] },
      { side: 'after', explanation: 'Range Scan · (A,1,4) 범위로 직접 이동', checking: ['after-A14'], matched: ['after-A14'], skipped: ['after-A11', 'after-A12'] },
    ],
    note: '예시 키입니다. Skip Scan은 b 값마다 범위를 다시 찾지만 c=1·2 키를 모두 읽지는 않습니다. a=B 키도 a=A 조건에서 제외됩니다. 실제 읽은 블록 수를 나타내지 않습니다.',
  },
  2: {
    id: 'case-2', title: 'JOIN과 집계의 전후', beforeTime: '10초 Timeout', afterTime: '평균 약 1초',
    frames: [
      { side: 'before', explanation: '알림 히스토리 블록 조회', checking: ['before-h100', 'before-h101', 'before-h102'] },
      { side: 'before', explanation: '재시도 히스토리 블록도 조회', checking: ['before-r100', 'before-r101a', 'before-r101b', 'before-r102'] },
      { side: 'before', explanation: 'JOIN · 알림 101의 실패·성공 재시도가 각각 한 행이 됨', checking: ['before-j100', 'before-j101a', 'before-j101b', 'before-j102'] },
      { side: 'before', explanation: 'GROUP BY · 다시 알림별 한 행으로 집계', checking: ['before-g100', 'before-g101', 'before-g102'], matched: ['before-g100', 'before-g101', 'before-g102'] },
      { side: 'before', explanation: 'ORDER BY notification_no DESC · 집계된 3건을 모두 정렬', checking: ['before-s102', 'before-s101', 'before-s100'] },
      { side: 'before', explanation: 'LIMIT 2 · 정렬된 3건 중 앞의 2건만 반환', matched: ['before-l102', 'before-l101'], skipped: ['before-s100'] },
      { side: 'after', explanation: '최종 상태가 같은 알림 블록에 저장됨', checking: ['after-h102', 'after-h101', 'after-h100'] },
      { side: 'after', explanation: '조회 시 재시도 테이블의 JOIN·집계를 건너뜀', skipped: ['after-retry'] },
      { side: 'after', explanation: 'event_time 인덱스 순서로 최신 두 블록 확인', checking: ['after-o102', 'after-o101'], matched: ['after-o102', 'after-o101'] },
      { side: 'after', explanation: '예시 LIMIT 2를 채워 다음 블록은 읽지 않고 종료', skipped: ['after-o100'] },
    ],
    note: '알림 번호와 LIMIT 2는 흐름을 설명하는 예시입니다. 표시된 시간은 전체 쿼리의 측정 결과입니다.',
  },
  3: {
    id: 'case-3', title: '중복 행을 만들지 않는 필터', beforeTime: '10초 이상 Timeout', afterTime: '약 1초',
    frames: [
      { side: 'before', explanation: '이벤트 E1·E2에서 연결된 서버 확인', checking: ['before-e1', 'before-e2'] },
      { side: 'before', explanation: '서비스 블록을 JOIN · S1에 서비스 세 개', checking: ['before-s1a', 'before-s1b', 'before-s1c', 'before-s2x'] },
      { side: 'before', explanation: '이벤트 E1이 중간 행 세 개로 복제됨', checking: ['before-j1a', 'before-j1b', 'before-j1c', 'before-j2x'] },
      { side: 'before', explanation: '제외 서비스는 거르고, E1 중간 행 세 개가 남음', matched: ['before-j1a', 'before-j1b', 'before-j1c'], skipped: ['before-j2x'] },
      { side: 'after', explanation: '이벤트 한 건씩 존재 여부만 확인', checking: ['after-e1', 'after-e2'] },
      { side: 'after', explanation: 'NOT EXISTS · S1은 제외 서비스가 없어 통과, S2에는 X가 있어 E2 제외', checking: ['after-notexists', 'after-service-s1', 'after-service-s2', 'after-e1', 'after-bypass'], skipped: ['after-e2'] },
      { side: 'after', explanation: 'EXISTS · S1 서버가 모니터링 그룹에 속해 E1 포함 · 중복 행은 생성하지 않음', checking: ['after-exists', 'after-group-s1'], matched: ['after-e1', 'after-zero'], skipped: ['after-dup1', 'after-dup2', 'after-dup3'] },
      { side: 'after', explanation: 'NOT EXISTS·EXISTS로 중간 행 0개 생성 · E1 한 건만 반환', matched: ['after-result'] },
    ],
    note: '일반 서비스 A/B/C와 모니터링 그룹 소속은 서로 다른 조건입니다. E1·E2는 예시이며 두 조건 변경의 개별 기여 시간은 측정하지 않았습니다.',
  },
};

const { caseNumber } = Astro.props;
const animation = animations[caseNumber];
const sides = ['before', 'after'] as const;
const indexRows = [
  { group: 'b=0', key: 'b0', rows: [{ key: 'A01', label: 'A · 0 · 1' }, { key: 'A02', label: 'A · 0 · 2' }, { key: 'A04', label: 'A · 0 · 4' }] },
  { group: 'b=1', key: 'b1', rows: [{ key: 'A11', label: 'A · 1 · 1' }, { key: 'A12', label: 'A · 1 · 2' }, { key: 'A14', label: 'A · 1 · 4' }] },
];
---

<section class="query-animation" data-query-animation data-case-id={animation.id} data-frames={JSON.stringify(animation.frames)} aria-label={`${animation.title} 애니메이션`}>
  <div class="query-animation-heading">
    <div>
      <p class="query-animation-eyebrow">BEFORE → AFTER · DATA FLOW</p>
      <h3>{animation.title}</h3>
    </div>
        <span class="query-animation-counter" data-frame-counter>01 / {String(animation.frames.length).padStart(2, '0')}</span>
  </div>
  <div class="query-animation-grid">
    {sides.map((side) => (
      <div class:list={['query-animation-lane', `query-animation-${side}`]} data-side={side}>
        <div class="query-animation-lane-head">
          <span>{side === 'before' ? 'BEFORE' : 'AFTER'}</span>
          <strong>{side === 'before' ? animation.beforeTime : animation.afterTime}</strong>
        </div>
        {caseNumber === 1 && (
          <div class="data-viz data-viz-index">
            <div class="data-viz-query" aria-label="검색 조건">
              <span data-node={`${side}-qa`}>a = A</span>
              <span class:list={{ 'is-missing': side === 'before' }} data-node={`${side}-qb`}>{side === 'before' ? 'b = ?' : 'b IN (0,1)'}</span>
              <span data-node={`${side}-qc`}>c = 4</span>
            </div>
            <div class="data-viz-flow-label">INDEX (a, b, c) <span>↓</span></div>
            {indexRows.map((group) => (
              <div class="data-viz-index-group">
                <span class="data-viz-prefix" data-node={`${side}-${group.key}`}>{group.group}<small>{side === 'before' ? '값 탐색' : '명시된 값'}</small></span>
                <div class="data-viz-index-keys">
                  {group.rows.map((row) => <span class="data-viz-block" data-node={`${side}-${row.key}`}>{row.label}</span>)}
                </div>
              </div>
            ))}
            <div class="data-viz-other"><span>다른 a</span><div class="data-viz-index-keys"><span class="data-viz-block" data-node={`${side}-B01`}>B · 0 · 1</span><span class="data-viz-block" data-node={`${side}-B02`}>B · 0 · 2</span><span class="data-viz-block" data-node={`${side}-B04`}>B · 0 · 4</span><span class="data-viz-block" data-node={`${side}-B14`}>B · 1 · 4</span></div></div>
          </div>
        )}
        {caseNumber === 2 && side === 'before' && (
          <div class="data-viz data-viz-join">
            <div class="data-viz-sources">
              <div class="data-viz-table"><span class="data-viz-label">notification_history</span><span class="data-viz-block" data-node="before-h100">알림 100</span><span class="data-viz-block" data-node="before-h101">알림 101</span><span class="data-viz-block" data-node="before-h102">알림 102</span></div>
              <div class="data-viz-table"><span class="data-viz-label">retry_history</span><span class="data-viz-block" data-node="before-r100">100 · 실패</span><span class="data-viz-block" data-node="before-r101a">101 · 실패</span><span class="data-viz-block" data-node="before-r101b">101 · 성공</span><span class="data-viz-block" data-node="before-r102">102 · 실패</span></div>
            </div>
            <div class="data-viz-flow-label">JOIN <span>↓</span></div>
            <div class="data-viz-result-row data-viz-joined-rows"><span class="data-viz-block" data-node="before-j100">100 × 실패</span><span class="data-viz-block is-duplicate" data-node="before-j101a">101 × 실패</span><span class="data-viz-block is-duplicate" data-node="before-j101b">101 × 성공</span><span class="data-viz-block" data-node="before-j102">102 × 실패</span></div>
            <div class="data-viz-flow-label">GROUP BY <span>↓</span></div>
            <div class="data-viz-result-row"><span class="data-viz-block" data-node="before-g100">100 · 실패</span><span class="data-viz-block" data-node="before-g101">101 · 성공</span><span class="data-viz-block" data-node="before-g102">102 · 실패</span></div>
            <div class="data-viz-flow-label">ORDER BY notification_no DESC · 전체 정렬 <span>↓</span></div>
            <div class="data-viz-result-row"><span class="data-viz-block" data-node="before-s102">102 · 실패</span><span class="data-viz-block" data-node="before-s101">101 · 성공</span><span class="data-viz-block" data-node="before-s100">100 · 실패</span></div>
            <div class="data-viz-flow-label">LIMIT 2 · 앞의 2건만 <span>↓</span></div>
            <div class="data-viz-result-row"><span class="data-viz-block" data-node="before-l102">102 · 실패</span><span class="data-viz-block" data-node="before-l101">101 · 성공</span></div>
          </div>
        )}
        {caseNumber === 2 && side === 'after' && (
          <div class="data-viz data-viz-join">
            <div class="data-viz-table"><span class="data-viz-label">notification_history · 상태 저장</span><span class="data-viz-block" data-node="after-h102">102 · 최신 · 실패</span><span class="data-viz-block" data-node="after-h101">101 · 성공</span><span class="data-viz-block" data-node="after-h100">100 · 실패</span></div>
            <div class="data-viz-bypass" data-node="after-retry">retry_history <strong>JOIN 없음 ↷</strong></div>
            <div class="data-viz-flow-label">event_time DESC · LIMIT 2 <span>↓</span></div>
            <div class="data-viz-table"><span class="data-viz-label">인덱스 순서로 읽기</span><span class="data-viz-block" data-node="after-o102">102 · 첫 번째</span><span class="data-viz-block" data-node="after-o101">101 · 두 번째</span><span class="data-viz-block" data-node="after-o100">100 · 다음 블록</span></div>
          </div>
        )}
        {caseNumber === 3 && side === 'before' && (
          <div class="data-viz data-viz-exists">
            <div class="data-viz-sources">
              <div class="data-viz-table"><span class="data-viz-label">event</span><span class="data-viz-block" data-node="before-e1">E1 → S1</span><span class="data-viz-block" data-node="before-e2">E2 → S2</span></div>
              <div class="data-viz-table"><span class="data-viz-label">server · service</span><span class="data-viz-block" data-node="before-s1a">S1 · 일반 A</span><span class="data-viz-block" data-node="before-s1b">S1 · 일반 B</span><span class="data-viz-block" data-node="before-s1c">S1 · 일반 C</span><span class="data-viz-block" data-node="before-s2x">S2 · 제외 X</span></div>
            </div>
            <div class="data-viz-flow-label">LEFT JOIN · E1 중간 행 3개 <span>↓</span></div>
            <div class="data-viz-result-row data-viz-joined-rows"><span class="data-viz-block is-duplicate" data-node="before-j1a">E1 × A</span><span class="data-viz-block is-duplicate" data-node="before-j1b">E1 × B</span><span class="data-viz-block is-duplicate" data-node="before-j1c">E1 × C</span><span class="data-viz-block" data-node="before-j2x">E2 × X</span></div>
            <div class="data-viz-flow-label">IS NULL · IN 조건</div>
          </div>
        )}
        {caseNumber === 3 && side === 'after' && (
          <div class="data-viz data-viz-exists">
            <div class="data-viz-sources">
              <div class="data-viz-table"><span class="data-viz-label">event · 한 건씩 확인</span><span class="data-viz-block" data-node="after-e1">E1 → S1</span><span class="data-viz-block" data-node="after-e2">E2 → S2</span></div>
              <div class="data-viz-table"><span class="data-viz-label">서비스 / 서버 그룹 · 별도 조건</span><span class="data-viz-block" data-node="after-service-s1">S1 · 일반 서비스 A/B/C</span><span class="data-viz-block" data-node="after-service-s2">S2 · 제외 서비스 X</span><span class="data-viz-block" data-node="after-group-s1">S1 · 모니터링 그룹 서버</span></div>
            </div>
            <div class="data-viz-flow-label">존재 여부만 확인 · 행 복제 없음 <span>↓</span></div>
            <div class="data-viz-predicates"><span class="data-viz-block" data-node="after-notexists">NOT EXISTS<br /><small>S1: 제외 서비스 없음 → 통과<br />S2: 제외 X 있음 → E2 제외</small></span><span class="data-viz-block" data-node="after-exists">EXISTS<br /><small>S1: 모니터링 그룹 소속<br />→ E1 포함</small></span></div>
            <div class="data-viz-bypass data-viz-bypass-duplicates" data-node="after-bypass">
              <div class="data-viz-bypass-heading"><span>JOIN으로 만들던 E1 중간 행</span><strong>3개 모두 생략 ↷</strong><b data-node="after-zero">생성 0개</b></div>
              <div class="data-viz-bypass-blocks"><span class="data-viz-block" data-node="after-dup1">E1 × A</span><span class="data-viz-block" data-node="after-dup2">E1 × B</span><span class="data-viz-block" data-node="after-dup3">E1 × C</span></div>
            </div>
            <div class="data-viz-flow-label">결과 <span>↓</span></div>
            <div class="data-viz-result-row"><span class="data-viz-block" data-node="after-result">E1 · 한 건</span></div>
          </div>
        )}
      </div>
    ))}
  </div>
  <div class="query-animation-legend" aria-hidden="true"><span><i class="legend-checking"></i>확인 중</span><span><i class="legend-matched"></i>조건 일치</span><span><i class="legend-skipped"></i>건너뜀</span></div>
  <div class="query-animation-narration" aria-live="polite" data-narration>{animation.frames[0].explanation}</div>
  <div class="query-animation-controls">
    <div class="query-animation-buttons">
      <button type="button" data-action="previous" aria-label="이전 단계">←</button>
      <button type="button" data-action="play" aria-label="애니메이션 재생">재생 ▶</button>
      <button type="button" data-action="next" aria-label="다음 단계">→</button>
    </div>
    <div class="query-animation-progress" aria-hidden="true"><span data-progress style={`width: ${100 / animation.frames.length}%`}></span></div>
  </div>
  <p class="query-animation-note">{animation.note}</p>
</section>
